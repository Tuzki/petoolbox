---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Locale } from '@/lib/i18n/config';
import { getMessages } from '@/lib/i18n/messages';
import { defaultRCSnubberInputs, calculateRCSnubber } from '@/lib/rcSnubberFirstPass';
const { locale } = Astro.props as { locale: Locale };
const tool = getMessages(locale).tools.items['rc-snubber-first-pass-designer'];
const d = defaultRCSnubberInputs;
const r = calculateRCSnubber(d) as any;
const en = locale === 'en';
const t = en ? {
  eyebrow:'Engineering Calculators', intro:'Extract an equivalent parasitic LC network from two ringing measurements, then screen a series RC snubber starting point.',
  inputs:'Design Inputs', measure:'Ringing Measurement', operating:'Operating Conditions', ratings:'Optional Ratings', calculate:'Calculate first-pass design',
  design:'Recommended Starting Design', parasitics:'Extracted Parasitics', stress:'Stress Estimate', bench:'Bench Tuning Candidates', checks:'Design Checks',
  status:'Overall Status', cap:'Recommended Snubber Capacitor', res:'Recommended Snubber Resistor', loss:'Estimated Average Loss', raw:'Calculated raw value', standard:'Recommended standard value',
  how:'How to Use an RC Snubber', math:'Mathematical and Physical Basis', refs:'References and Design Basis',
  review:'Review', pass:'Pass', fail:'Fail', missing:'Ratings left blank: component rating verification is incomplete.',
  disclaimer:'First-pass estimate. Verify ringing amplitude, resistor temperature, capacitor voltage stress and resistor pulse capability on hardware.'
} : {
  eyebrow:'工程计算工具', intro:'通过两次振铃频率测量反推等效寄生 LC 网络，并初筛串联 RC Snubber 的台架调试起点。',
  inputs:'设计输入', measure:'振铃测量', operating:'工作条件', ratings:'可选器件额定值', calculate:'计算初步设计',
  design:'建议初始设计', parasitics:'反推寄生参数', stress:'应力估算', bench:'台架调试候选值', checks:'设计检查',
  status:'总体状态', cap:'建议 Snubber 电容', res:'建议 Snubber 电阻', loss:'估算平均损耗', raw:'计算原始值', standard:'建议标准值',
  how:'RC Snubber 的安装与使用方法', math:'数学与物理依据', refs:'参考资料与设计依据',
  review:'复核', pass:'通过', fail:'不通过', missing:'额定值留空：无法完成器件额定值验证。',
  disclaimer:'本结果仅用于初步设计。必须在实际硬件上验证振铃幅值、电阻温升、电容电压应力以及电阻脉冲承受能力。'
};
const f = { pf:(v:number)=>`${(v*1e12).toFixed(1)} pF`, ohm:(v:number)=>`${v.toFixed(1)} Ω`, uh:(v:number)=>`${(v*1e6).toFixed(3)} µH`, ns:(v:number)=>`${(v*1e9).toFixed(1)} ns`, w:(v:number)=>`${v.toFixed(3)} W`, a:(v:number)=>`${v.toFixed(3)} A` };
---
<BaseLayout title={tool.title} description={tool.description} pathname="/tools/rc-snubber-first-pass-designer/" locale={locale}>
  <main class="tool-shell rc-snubber-tool">
    <nav class="breadcrumbs"><a href={`/${locale}/tools/`}>{en?'Tools':'工具'}</a><span>/</span><span>{tool.title}</span></nav>
    <header class="tool-hero"><p class="eyebrow">{t.eyebrow}</p><h1>{tool.title}</h1><p>{t.intro}</p>
      <svg class="snubber-diagram" viewBox="0 0 620 150" role="img" aria-label={en?'Series resistor and capacitor connected across a ringing node':'串联电阻和电容并联在振铃节点两端'}><path d="M40 30H580M40 120H580M110 30v35h65l12-15 24 30 24-30 24 30 12-15h65v55M110 120v-55M336 65h55M391 45v40M411 45v40M411 65h99v55"/><text x="215" y="45">Rs</text><text x="380" y="35">Cs</text><text x="20" y="23">SW</text><text x="15" y="140">REF</text></svg>
    </header>
    <form class="tool-card" data-snubber-form>
      <h2>{t.inputs}</h2><div class="input-columns">
        <fieldset><legend>{t.measure}</legend>
          <label>f0 · {en?'Original ringing frequency':'原始振铃频率'}<input data-input="f0MHz" type="number" step="any" value={d.f0MHz}/><span>MHz</span></label>
          <label>Ctest · {en?'Test capacitor':'测试电容'}<input data-input="cTestPf" type="number" step="any" value={d.cTestPf}/><span>pF</span></label>
          <label>f1 · {en?'Shifted ringing frequency':'偏移后振铃频率'}<input data-input="f1MHz" type="number" step="any" value={d.f1MHz}/><span>MHz</span></label>
        </fieldset><fieldset><legend>{t.operating}</legend>
          <label>ΔV · {en?'Snubber voltage step':'Snubber 电压跃迁'}<input data-input="deltaVV" type="number" step="any" value={d.deltaVV}/><span>V</span></label>
          <label>fsw · {en?'Switching frequency':'开关频率'}<input data-input="switchingFrequencyKhz" type="number" step="any" value={d.switchingFrequencyKhz}/><span>kHz</span></label>
          <label>Ne · {en?'Full-swing events per cycle':'每周期完整电压跃迁'}<select data-input="eventsPerCycle"><option value="1">{en?'1 event per switching cycle':'每开关周期 1 次完整电压跃迁'}</option><option value="2" selected>{en?'2 events per switching cycle':'每开关周期 2 次完整电压跃迁'}</option></select></label>
          <label>kC · {en?'Capacitor multiplier':'电容倍数'}<input data-input="capacitorMultiplier" type="number" step="any" value={d.capacitorMultiplier}/></label>
          <label>kR · {en?'Resistor multiplier':'电阻倍数'}<input data-input="resistorMultiplier" type="number" step="any" value={d.resistorMultiplier}/></label>
        </fieldset><fieldset><legend>{t.ratings}</legend>
          <label>{en?'Snubber resistor rated power':'Snubber 电阻额定功率'}<input data-input="resistorRatedPowerW" type="number" step="any" placeholder={en?'Optional':'可留空'}/><span>W</span></label>
          <label>{en?'Snubber capacitor voltage rating':'Snubber 电容额定电压'}<input data-input="capacitorVoltageRatingV" type="number" step="any" placeholder={en?'Optional':'可留空'}/><span>V</span></label>
          <label>{en?'Power derating limit':'功率降额限制'}<input data-input="powerDeratingLimit" type="number" step="any" value="60"/><span>%</span></label>
          <label>{en?'Voltage derating limit':'电压降额限制'}<input data-input="voltageDeratingLimit" type="number" step="any" value="80"/><span>%</span></label>
        </fieldset></div><button type="submit">{t.calculate}</button><p data-error hidden></p>
    </form>
    <section id="results" class="results-grid">
      <article class="tool-result-card tool-result-card--primary"><div class="tool-result-card__heading"><h2>{t.design}</h2><span class="status-pill status-review" data-status>{t.review}</span></div><div class="metric-grid">
        <div><span>{t.cap}</span><strong data-output="cs">{f.pf(r.cs)}</strong></div><div><span>{t.res}</span><strong data-output="rs">{f.ohm(r.rs)}</strong></div><div><span>{t.loss}</span><strong data-output="loss">{f.w(r.averageLoss)}</strong></div><div><span>{t.status}</span><strong data-output="status">{t.review}</strong></div>
        <div><span>{t.raw} Cs</span><strong data-output="csRaw">{f.pf(r.csRaw)}</strong></div><div><span>{t.raw} Rs</span><strong data-output="rsRaw">{f.ohm(r.rsRaw)}</strong></div></div><p>{t.disclaimer}</p></article>
      <article class="tool-result-card"><h2>{t.parasitics}</h2><div class="metric-grid"><div><span>f0 / f1</span><strong data-output="ratio">{r.ratio.toFixed(3)}</strong></div><div><span>Cp</span><strong data-output="cp">{f.pf(r.cp)}</strong></div><div><span>Lp</span><strong data-output="lp">{f.uh(r.lp)}</strong></div><div><span>Z0</span><strong data-output="z0">{f.ohm(r.z0)}</strong></div><div><span>{en?'Original ringing period':'原始振铃周期'}</span><strong data-output="t0">{f.ns(r.originalPeriod)}</strong></div><div><span>{en?'Shifted ringing period':'偏移后振铃周期'}</span><strong data-output="t1">{f.ns(r.shiftedPeriod)}</strong></div></div></article>
      <article class="tool-result-card"><h2>{t.stress}</h2><div class="metric-grid"><div><span>{en?'Energy per event':'单次事件能量'}</span><strong data-output="energy">1.000 µJ</strong></div><div><span>{en?'Events per second':'每秒事件数'}</span><strong data-output="events">200.0 kHz</strong></div><div><span>{en?'Initial peak current':'初始峰值电流'}</span><strong data-output="ipk">{f.a(r.peakCurrent)}</strong></div><div><span>{en?'Equivalent RMS current':'等效 RMS 电流'}</span><strong data-output="irms">{(r.rmsCurrent*1e3).toFixed(1)} mA</strong></div><div><span>{en?'Initial peak power':'初始瞬时功率'}</span><strong data-output="ppk">{r.peakPower.toFixed(1)} W</strong></div><div><span>τ / 3τ / 5τ</span><strong data-output="tau">26.0 / 78.0 / 130.0 ns</strong></div><div><span>{en?'Event interval':'事件间隔'}</span><strong data-output="interval">5.000 µs</strong></div><div><span>5τ / {en?'event interval':'事件间隔'}</span><strong data-output="settling">2.60%</strong></div></div><p>{en?'Peak power is the theoretical instant at the start of an ideal voltage step—not a continuous rating. Check the resistor pulse-overload or single-pulse-energy curve.':'峰值功率是理想电压阶跃开始瞬间的理论值，不是连续额定功率。必须检查电阻 pulse overload / single-pulse energy 曲线。'}</p></article>
      <article class="tool-result-card"><h2>{t.bench}</h2><table><thead><tr><th>{en?'Position':'相对位置'}</th><th>{t.raw}</th><th>E24</th></tr></thead><tbody data-candidates>{r.candidates.map((c:any)=><tr><td>{c.factor} Z0</td><td>{f.ohm(c.raw)}</td><td>{f.ohm(c.standard)}</td></tr>)}</tbody></table><p>{en?'Lower resistance provides a stronger instantaneous-current path but can increase loss or over-damping; higher resistance limits current but may not suppress the first peak. Confirm at actual voltage, load, temperature and PCB conditions—no candidate is guaranteed to minimize overshoot.':'较低阻值通常提供更强的瞬时电流通道，但可能增加损耗或引入过阻尼；较高阻值会限制电流，但可能不足以抑制第一峰值。必须在实际电压、负载、温度和 PCB 条件下确认，任何候选都不保证产生最低过冲。'}</p></article>
      <article class="tool-result-card"><h2>{t.checks}</h2><ul data-checks><li>{t.missing}</li><li>{en?'Resistor pulse capability must be verified.':'必须检查电阻脉冲耐量。'}</li><li>{en?'Test capacitance can include probe, pad and mounting parasitics.':'测试电容可能包含探头、焊盘和安装寄生误差。'}</li></ul></article>
    </section>
    <section class="prose-card"><h2>{t.how}</h2>
      <h3>{en?'What it is and where it connects':'它是什么以及常见连接位置'}</h3><p>{en?'An RC snubber is a series resistor–capacitor branch placed across the device or node that rings. The capacitor bypasses high-frequency ringing current; the resistor dissipates energy and lowers Q. It does not remove parasitics—it changes damping and the high-frequency current path. Common placements include MOSFET D-S, across a diode, switch node to power ground/reference, transformer secondary rectifier nodes, and half-bridge, full-bridge or synchronous-rectifier nodes. Connect it across the actual ringing loop, not arbitrary nodes; a wrong connection can increase common-mode current, loss or device stress.':'RC Snubber 是并联在发生振铃的器件或节点两端的串联电阻—电容支路。电容为高频振铃电流提供旁路，电阻耗散能量并降低 Q 值。它不会消除寄生参数，而是改变阻尼和高频电流路径。常见位置包括 MOSFET D-S、二极管两端、开关节点到功率地或参考节点、变压器次级整流节点，以及半桥、全桥和同步整流节点。必须跨接实际振铃回路，不能机械地跨接任意节点；错误连接可能增加共模电流、损耗或器件应力。'}</p>
      <h3>{en?'PCB layout and measurement':'PCB 布局与测量'}</h3><p>{en?'Keep the snubber loop extremely short, place both parts next to the device, and use a direct return—not long traces or a detour through a large system-ground area. Snubber layout inductance weakens high-frequency action. Measure with a ground spring or coaxial connection; a long probe ground can create false ringing.':'Snubber 回路必须尽可能短，电阻和电容应靠近被吸收器件，回流路径必须直接，不要通过长走线或大面积系统地绕行。Snubber 自身布局电感会削弱高频效果。示波器应使用短地弹簧或同轴测量，避免长接地线制造假振铃。'}</p>
      <h3>{en?'Bench procedure':'实际调试步骤'}</h3><ol>{(en?['Measure f0 without a snubber.','Temporarily parallel a known, low-ESL Ctest.','Measure f1 at the same operating point.','Enter all three measurements here.','Start with the recommended standard Cs and Rs.','Measure first peak, subsequent ringing and temperature.','Try resistance near 0.5Z0, 0.75Z0, Z0 and 1.25Z0.','Verify at minimum, nominal and maximum input voltage.','Verify at light, rated and peak load.','Verify loss at maximum switching frequency and high temperature.','Check resistor pulse-overload curves and capacitor high-frequency behavior.','Choose final values from bench results.']:['未安装 Snubber 时测量 f0。','临时并联已知的低 ESL 测试电容 Ctest。','相同工况下测量 f1。','将三项测量输入本工具。','先采用建议标准值 Cs 和 Rs。','测量第一峰值、后续振铃和器件温升。','试验 0.5Z0、0.75Z0、Z0、1.25Z0 附近阻值。','在最低、额定和最高输入电压下验证。','在轻载、额定和峰值负载下验证。','在最高开关频率和高温条件下验证功耗。','检查电阻脉冲曲线和电容高频特性。','最终参数以台架结果为准。']).map(x=><li>{x}</li>)}</ol>
      <h3>{en?'Measurement cautions':'测量注意事项'}</h3><p>{en?'Ctest is temporary and is not the final snubber capacitor. Use a known low-ESL part at nearly the final location. Probe capacitance joins Cp. Keep voltage, load, switching frequency and probing identical. A small frequency shift amplifies measurement error; nonlinear Coss, junction capacitance and voltage dependence mean the result represents only that operating point.':'Ctest 是临时测量电容，不等于最终 Snubber 电容。应使用已知容值、低 ESL 器件，并尽量焊在最终位置。探头电容会成为 Cp 的一部分。两次测量必须保持输入电压、负载、开关频率和探测方式一致。频移太小会放大误差；非线性 Coss、结电容和电压变化使结果只代表该测量工况。'}</p>
    </section>
    <section class="prose-card"><h2>{t.math}</h2><h3>{en?'Physical origin and natural frequency':'振铃来源与自然频率'}</h3><p>{en?'PCB and package inductance, transformer leakage, MOSFET Coss, diode junction and winding capacitance, plus probe and pad capacitance form an equivalent LC network. Fast switching exchanges stored energy WL = 0.5Li² and WC = 0.5Cv²; loss makes it decay. In a linear, small-signal lumped model:':'PCB 回路与封装电感、变压器漏感、MOSFET Coss、二极管结电容、绕组电容以及探头和焊盘寄生共同形成等效 LC。快速开关时，WL = 0.5Li² 与 WC = 0.5Cv² 的储能交替，实际损耗使其衰减。在线性、小信号、集中参数模型中：'}</p><p class="formula">ω0 = 1 / √(Lp Cp)<br/>f0 = 1 / [2π√(Lp Cp)]</p>
      <h3>{en?'Frequency-shift derivation':'增加测试电容的推导'}</h3><p class="formula">f0 = 1 / [2π√(Lp Cp)]<br/>f1 = 1 / [2π√(Lp (Cp + Ctest))]<br/>(f0 / f1)² = (Cp + Ctest) / Cp<br/>Cp = Ctest / [(f0 / f1)² − 1]<br/>Lp = 1 / [(2πf0)² Cp]</p>
      <h3>{en?'Characteristic impedance and damping':'特征阻抗与阻尼'}</h3><p class="formula">Z0 = √(Lp / Cp)</p><p>{en?'Z0 is the natural voltage-to-oscillating-current scale. Rs near Z0 is a common first-pass start, not a uniquely optimal value; topology, placement, nonlinear capacitance, edge rate and layout matter. At high frequency Cs is a low-impedance path and Rs converts energy to heat. Too little Cs may under-absorb; too much raises loss. Too much Rs may under-damp; too little raises peak current and loss.':'Z0 描述电压与振荡电流的自然比例尺度。Rs 取 Z0 附近是常见一阶起点，并非唯一最优值；拓扑、连接位置、非线性电容、边沿和布局都会影响结果。高频瞬态时 Cs 提供低阻通道，Rs 将能量转为热。Cs 太小可能吸收不足，太大会增加损耗；Rs 太大可能阻尼不足，太小会增加峰值电流与损耗。'}</p>
      <h3>{en?'Energy, loss and limits':'能量、功耗与模型限制'}</h3><p class="formula">Eevent = 0.5 Cs ΔV²<br/>Psnub = Ne × Eevent × fsw</p><p>{en?'Ne is the number of full swings per switching cycle: choose 1 for one effective event or 2 for two equal full events. Waveform shape, residual voltage and incomplete charge can change actual loss; this is screening, not thermal proof. The model assumes one dominant mode, fixed Lp, parallel Ctest and a lumped linear network. It ignores nonlinear Coss/junction capacitance, reverse recovery, current-dependent or magnetic nonlinearities and nearby modes. Results apply near the measured condition and require hardware verification.':'Ne 是每周期完整跃迁次数：一次有效事件选 1，两次等幅完整事件选 2。实际波形、残余电压和非完整充放电会改变损耗；该式只用于初筛，不替代热测试。模型假设单一主模态、Lp 不变、Ctest 近似并联且回路可集中参数线性化；忽略 Coss/结电容非线性、反向恢复、电流相关电感、磁性非线性和多个相近模态。结果仅适用于测量工况附近，必须实测验证。'}</p>
    </section>
    <section class="prose-card"><h2>{t.refs}</h2><ul>
      <li><a href="https://www.ti.com/lit/pdf/ssztbc7" target="_blank" rel="noopener noreferrer">{en?'Power Tips: Calculate an R-C Snubber in Seven Steps':'Power Tips：七步计算 R-C Snubber'}</a> — Texas Instruments. {en?'Supports frequency-shift extraction, Cs ≈ 3Cp, Rs near characteristic impedance and bench tuning.':'支持频移提取、Cs ≈ 3Cp、Rs 取特征阻抗附近以及台架调优。'}</li>
      <li><a href="https://www.ti.com/lit/pdf/slva255" target="_blank" rel="noopener noreferrer">Minimizing Ringing at the Switch Node of a Boost Converter</a> — Texas Instruments. {en?'Supports the C·V²·fsw loss relationship, component tradeoffs and layout in a boost-converter example; other topologies still require verification.':'以 Boost 变换器为例支持 C·V²·fsw 损耗关系、器件折中与布局；其他拓扑仍需验证。'}</li>
      <li><a href="https://www.ti.com/lit/pdf/slpa010" target="_blank" rel="noopener noreferrer">Ringing Reduction Techniques for NexFET High Performance MOSFETs</a> — Texas Instruments. {en?'Supports practical resistance variation, measurement and PCB guidance for a synchronous-buck context.':'在同步 Buck 背景下支持电阻变化、测量和 PCB 工程指导。'}</li></ul><p>{en?'This calculator converts published first-pass design methods into an interactive engineering estimate. The equations do not replace bench measurement or component manufacturer pulse-rating verification.':'本工具将公开的一阶设计方法转化为交互式工程估算。公式不能替代台架测量，也不能替代器件厂商对电阻脉冲能力和电容高频特性的验证。'}</p>
      <p><strong>{en?'Scope boundary:':'工具边界：'}</strong> {en?'Series RC only—not RCD clamps, flyback leakage-energy clamps, TVS or active-clamp selection, exact nonlinear Coss/reverse-recovery models, automatic waveform fitting, final EMI compliance, or an exact optimal damping value.':'仅处理串联 RC；不处理 RCD clamp、Flyback 漏感能量钳位、TVS 或有源钳位选择、精确非线性 Coss/反向恢复模型、自动波形拟合、最终 EMI 合规结论或精确最优阻尼值。'}</p><p>{t.disclaimer}</p>
    </section>
  </main>
</BaseLayout>

<script>
  import { calculateRCSnubber } from '@/lib/rcSnubberFirstPass';
  const form = document.querySelector<HTMLFormElement>('[data-snubber-form]');
  const out=(k:string,v:string)=>{ const el=document.querySelector(`[data-output="${k}"]`); if(el) el.textContent=v; };
  const num=(k:string)=>Number((form?.querySelector(`[data-input="${k}"]`) as HTMLInputElement)?.value);
  const optional=(k:string)=>{const v=(form?.querySelector(`[data-input="${k}"]`) as HTMLInputElement)?.value; return v===''?undefined:Number(v)};
  form?.addEventListener('submit',(event)=>{event.preventDefault(); const x:any=calculateRCSnubber({f0MHz:num('f0MHz'),cTestPf:num('cTestPf'),f1MHz:num('f1MHz'),deltaVV:num('deltaVV'),switchingFrequencyKhz:num('switchingFrequencyKhz'),eventsPerCycle:num('eventsPerCycle') as 1|2,capacitorMultiplier:num('capacitorMultiplier'),resistorMultiplier:num('resistorMultiplier'),resistorRatedPowerW:optional('resistorRatedPowerW'),capacitorVoltageRatingV:optional('capacitorVoltageRatingV'),powerDeratingLimit:num('powerDeratingLimit')/100,voltageDeratingLimit:num('voltageDeratingLimit')/100});
    const error=form.querySelector<HTMLElement>('[data-error]'); if(x.status==='fail'&&!x.ratio){if(error){error.hidden=false;error.textContent='Check positive inputs and ensure f1 < f0.'}return} if(error)error.hidden=true;
    const pf=(v:number)=>`${(v*1e12).toFixed(1)} pF`, ohm=(v:number)=>`${v.toFixed(1)} Ω`, ns=(v:number)=>`${(v*1e9).toFixed(1)} ns`;
    out('cs',pf(x.cs));out('rs',ohm(x.rs));out('loss',`${x.averageLoss.toFixed(3)} W`);out('status',x.status);out('csRaw',pf(x.csRaw));out('rsRaw',ohm(x.rsRaw));out('ratio',x.ratio.toFixed(3));out('cp',pf(x.cp));out('lp',`${(x.lp*1e6).toFixed(3)} µH`);out('z0',ohm(x.z0));out('t0',ns(x.originalPeriod));out('t1',ns(x.shiftedPeriod));out('energy',`${(x.eventEnergy*1e6).toFixed(3)} µJ`);out('events',`${(x.eventsPerSecond/1e3).toFixed(1)} kHz`);out('ipk',`${x.peakCurrent.toFixed(3)} A`);out('irms',`${(x.rmsCurrent*1e3).toFixed(1)} mA`);out('ppk',`${x.peakPower.toFixed(1)} W`);out('tau',`${ns(x.tau)} / ${ns(3*x.tau)} / ${ns(5*x.tau)}`);out('interval',`${(x.eventInterval*1e6).toFixed(3)} µs`);out('settling',`${(x.settlingRatio*100).toFixed(2)}%`);
    const badge=document.querySelector<HTMLElement>('[data-status]');if(badge){badge.textContent=x.status;badge.className=`status-pill status-${x.status}`}
    const body=document.querySelector('[data-candidates]');if(body)body.innerHTML=x.candidates.map((c:any)=>`<tr><td>${c.factor} Z0</td><td>${ohm(c.raw)}</td><td>${ohm(c.standard)}</td></tr>`).join('');
  });
</script>

