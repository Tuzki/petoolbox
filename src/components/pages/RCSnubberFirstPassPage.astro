---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Locale } from '@/lib/i18n/config';
import { getMessages } from '@/lib/i18n/messages';
import { defaultRCSnubberInputs as d, calculateRCSnubber } from '@/lib/rcSnubberFirstPass';
const { locale } = Astro.props as { locale: Locale };
const en = locale === 'en';
const tool = getMessages(locale).tools.items['rc-snubber-first-pass-designer'];
const r = calculateRCSnubber(d) as any;
const statusText = (status:string) => en ? ({pass:'Pass',review:'Review',fail:'Fail'} as any)[status] : ({pass:'通过',review:'复核',fail:'不通过'} as any)[status];
const tx = en ? {
  eyebrow:'Engineering Calculators', intro:'Extract an equivalent parasitic LC network from two ringing measurements, then screen a practical series RC snubber starting point.', connection:'RC Snubber Connection', placement:'Example placement: RC snubber across MOSFET drain-source', example:'This MOSFET example shows the topology only. Place the series RC branch directly across the device or node that actually rings.',
  inputs:'Design Inputs', measure:'Ringing Measurement', operating:'Operating Conditions', ratings:'Optional Component Ratings', optional:'Leave ratings blank to calculate without completing component-rating checks.', calculate:'Calculate First-Pass Design',
  design:'Recommended Starting Design', parasitics:'Extracted Parasitics', stress:'Stress Estimate', checks:'Engineering Checks', bench:'Bench Tuning Candidates', how:'How to Use an RC Snubber', math:'Mathematical and Physical Basis', refs:'References and Design Basis',
  cs:'Recommended Cs', rs:'Recommended Rs', loss:'Estimated Loss', status:'Status', rawCs:'Calculated Cs', rawRs:'Calculated Rs', disclaimer:'First-pass estimate. Verify ringing amplitude, resistor temperature, capacitor voltage stress and resistor pulse capability on hardware.',
  invalid:'Complete every required field with a positive finite value, keep f₁ below f₀, and use derating limits from 0% through 100%.'
} : {
  eyebrow:'工程计算工具', intro:'通过两次振铃频率测量反推等效寄生 LC 网络，并初筛实用的串联 RC Snubber 台架调试起点。', connection:'RC Snubber 连接示意', placement:'示例连接：RC Snubber 跨接在 MOSFET D-S 两端', example:'MOSFET 仅作为连接示例。串联 RC 支路应直接跨接在实际发生振铃的器件或节点两端。',
  inputs:'设计输入', measure:'振铃测量', operating:'工作条件', ratings:'可选器件额定值', optional:'额定值可留空；仍会计算，但无法完成器件额定值检查。', calculate:'计算初步设计',
  design:'建议初始设计', parasitics:'反推寄生参数', stress:'应力估算', checks:'工程检查', bench:'台架调试候选值', how:'RC Snubber 的安装与使用方法', math:'数学与物理依据', refs:'参考资料与设计依据',
  cs:'建议 Cs', rs:'建议 Rs', loss:'估算损耗', status:'状态', rawCs:'计算 Cs', rawRs:'计算 Rs', disclaimer:'本结果仅用于初步设计。必须在实际硬件上验证振铃幅值、电阻温升、电容电压应力以及电阻脉冲承受能力。',
  invalid:'请为所有必填项输入有限正数，确保 f₁ 小于 f₀，并将降额限制设在 0% 至 100% 之间。'
};
const fmt={pf:(v:number)=>`${(v*1e12).toFixed(1)} pF`,ohm:(v:number)=>`${v.toFixed(1)} Ω`,uh:(v:number)=>`${(v*1e6).toFixed(3)} µH`,ns:(v:number)=>`${(v*1e9).toFixed(1)} ns`};
const fields = [
  {group:'measure',key:'f0MHz',label:en?'Original Ringing Frequency':'原始振铃频率',symbol:'f₀',unit:'MHz',value:d.f0MHz},
  {group:'measure',key:'cTestPf',label:en?'Test Capacitor':'测试电容',symbol:'Ctest',unit:'pF',value:d.cTestPf},
  {group:'measure',key:'f1MHz',label:en?'Shifted Ringing Frequency':'偏移后振铃频率',symbol:'f₁',unit:'MHz',value:d.f1MHz},
  {group:'operating',key:'deltaVV',label:en?'Voltage Step':'电压跃迁',symbol:'ΔV',unit:'V',value:d.deltaVV},
  {group:'operating',key:'switchingFrequencyKhz',label:en?'Switching Frequency':'开关频率',symbol:'fsw',unit:'kHz',value:d.switchingFrequencyKhz},
  {group:'operating',key:'capacitorMultiplier',label:en?'Capacitor Multiplier':'电容倍数',symbol:'kC',unit:'×',value:d.capacitorMultiplier},
  {group:'operating',key:'resistorMultiplier',label:en?'Resistor Multiplier':'电阻倍数',symbol:'kR',unit:'×',value:d.resistorMultiplier},
  {group:'ratings',key:'resistorRatedPowerW',label:en?'Resistor Rated Power':'电阻额定功率',symbol:'PR',unit:'W',value:undefined},
  {group:'ratings',key:'capacitorVoltageRatingV',label:en?'Capacitor Voltage Rating':'电容额定电压',symbol:'VC',unit:'V',value:undefined},
  {group:'ratings',key:'powerDeratingLimit',label:en?'Power Derating Limit':'功率降额限制',symbol:'DP',unit:'%',value:60},
  {group:'ratings',key:'voltageDeratingLimit',label:en?'Voltage Derating Limit':'电压降额限制',symbol:'DV',unit:'%',value:80}
];
const checkCopy:any = {
  en:{'positive-inputs':['Invalid required input','Required values must be finite and greater than zero.'],'frequency-order':['Invalid frequency order','Shifted frequency f₁ must be below original frequency f₀.'],'events':['Invalid event count','Choose one or two full-swing events per cycle.'],'derating-limit':['Invalid derating limit','Derating limits must not exceed 100%.'],'numerical':['Numerical result invalid','The selected inputs did not produce finite positive physical values.'],'power-rating-invalid':['Invalid resistor rating','Rated power must be positive or left blank.'],'power-rating-fail':['Resistor rating exceeded','Estimated average loss exceeds the entered rated power.'],'voltage-rating-invalid':['Invalid capacitor rating','Voltage rating must be positive or left blank.'],'voltage-rating-fail':['Capacitor rating exceeded','Voltage step exceeds the entered capacitor rating.'],'shift-too-small':['Frequency shift too small','The shift is too small for robust parasitic extraction.'],'shift-sensitive':['Frequency shift is sensitive','Extraction is usable but sensitive to measurement error.'],'power-rating-missing':['Resistor rating missing','Average-power rating cannot be verified.'],'power-derating':['Power derating exceeded','Average loss exceeds the configured derating limit.'],'voltage-rating-missing':['Capacitor rating missing','Capacitor voltage rating cannot be verified.'],'voltage-derating':['Voltage derating exceeded','Voltage stress exceeds the configured derating limit.'],'settling':['Settling time too long','Five time constants approach or exceed the event interval.'],'pulse-rating':['Pulse capability verification required','Check the resistor pulse-overload or single-pulse-energy curve.'],'measurement-parasitics':['Measurement parasitic warning','Probe, pad and mounting capacitance affect the extracted result.']},
  zh:{'positive-inputs':['必填输入无效','必填值必须为有限正数。'],'frequency-order':['频率顺序无效','偏移后频率 f₁ 必须低于原始频率 f₀。'],'events':['事件次数无效','每周期完整跃迁次数只能选择 1 或 2。'],'derating-limit':['降额限制无效','降额限制不得超过 100%。'],'numerical':['数值结果无效','当前输入未产生有限且为正的物理量。'],'power-rating-invalid':['电阻额定功率无效','额定功率必须为正数或留空。'],'power-rating-fail':['电阻额定功率超限','估算平均损耗超过输入的额定功率。'],'voltage-rating-invalid':['电容额定电压无效','额定电压必须为正数或留空。'],'voltage-rating-fail':['电容额定电压超限','电压跃迁超过输入的电容额定电压。'],'shift-too-small':['频率偏移过小','频率偏移不足以稳健反推寄生参数。'],'shift-sensitive':['频率偏移较敏感','参数可以提取，但对测量误差较敏感。'],'power-rating-missing':['电阻额定值留空','无法完成平均功率额定值检查。'],'power-derating':['功率降额超限','平均损耗超过设置的降额限制。'],'voltage-rating-missing':['电容额定值留空','无法完成电容额定电压检查。'],'voltage-derating':['电压降额超限','电压应力超过设置的降额限制。'],'settling':['建立时间过长','五倍时间常数接近或超过事件间隔。'],'pulse-rating':['需要验证脉冲能力','必须检查电阻 pulse overload 或 single-pulse energy 曲线。'],'measurement-parasitics':['测量寄生警告','探头、焊盘和安装电容会影响反推结果。']}
};
const initialChecks=[...r.errors.map((code:string)=>({code,status:'fail'})),...r.warnings.map((code:string)=>({code,status:['pulse-rating','measurement-parasitics'].includes(code)?'pass':'review'}))];
---
<BaseLayout title={tool.title} description={tool.description} pathname="/tools/rc-snubber-first-pass-designer/" locale={locale}>
<main class="page-shell tool-workbench rc-snubber-tool" data-rc-snubber data-locale={locale}>
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href={`/${locale}/`}>{getMessages(locale).site.breadcrumbs.home}</a><span>/</span><a href={`/${locale}/tools/`}>{en?'Tools':'工具'}</a><span>/</span><span>{tool.title}</span></nav>
  <header class="tool-workbench__header"><div><p class="section-eyebrow">{tx.eyebrow}</p><h1>{tool.title}</h1><p>{tx.intro}</p></div></header>

  <section class="connection-card" aria-labelledby="connection-title"><div class="section-heading"><div><p class="section-kicker">{tx.placement}</p><h2 id="connection-title">{tx.connection}</h2></div><p>{tx.example}</p></div>
    <svg viewBox="0 0 600 300" role="img" aria-labelledby="snubber-svg-title snubber-svg-desc">
      <title id="snubber-svg-title">{tx.placement}</title><desc id="snubber-svg-desc">{tx.example}</desc>
      <defs><marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0L10 5L0 10Z"/></marker></defs>
      <g class="wire"><path d="M150 48H450M150 252H450"/><path d="M205 48V98M205 202V252"/><path d="M395 48V78L378 86L412 100L378 114L412 128L378 142L395 150V172M395 194V252"/><path d="M365 172H425M365 194H425"/></g>
      <g class="device"><path d="M185 105V195M220 112V188M185 132H220M185 168H220M220 112L242 99M220 188L242 201"/><path d="M165 150H185"/></g>
      <g class="nodes"><circle cx="150" cy="48" r="6"/><circle cx="450" cy="48" r="6"/><circle cx="150" cy="252" r="6"/><circle cx="450" cy="252" r="6"/></g>
      <path class="current" d="M436 78V145" marker-end="url(#arrow)"/><path class="voltage" d="M520 76V224" marker-start="url(#arrow)" marker-end="url(#arrow)"/>
      <g class="labels"><text x="58" y="43">SW / Drain</text><text x="52" y="272">PGND / Source</text><text x="259" y="150">Q1 MOSFET</text><text x="420" y="116">Rs</text><text x="420" y="188">Cs</text><text x="458" y="112">i<tspan baseline-shift="sub" font-size="12">ring</tspan></text><text x="532" y="155">ΔV</text><text x="192" y="92">D</text><text x="192" y="220">S</text></g>
    </svg>
  </section>

  <form class="input-card" data-snubber-form novalidate><div class="section-heading"><div><p class="section-kicker">{en?'Measurement and operating point':'测量与工作点'}</p><h2>{tx.inputs}</h2></div></div>
    <div class="input-groups">
      {(['measure','operating','ratings'] as const).map((group)=><fieldset class:list={['input-group',group==='ratings'&&'input-group--optional']}><legend>{group==='measure'?tx.measure:group==='operating'?tx.operating:tx.ratings}</legend>
        {fields.filter(f=>f.group===group).map(field=><label class="field" for={`snubber-${field.key}`}><span class="field-label">{field.label} <var>{field.symbol}</var></span><span class="input-shell"><input id={`snubber-${field.key}`} name={field.key} data-input={field.key} type="number" inputmode="decimal" step="any" value={field.value}/><span class="input-unit">{field.unit}</span></span></label>)}
        {group==='operating'&&<label class="field" for="snubber-events"><span class="field-label">{en?'Events per Cycle':'每周期完整跃迁'} <var>Ne</var></span><span class="input-shell input-shell--select"><select id="snubber-events" name="eventsPerCycle" data-input="eventsPerCycle"><option value="1">{en?'1 event per switching cycle':'每开关周期 1 次完整电压跃迁'}</option><option value="2" selected>{en?'2 events per switching cycle':'每开关周期 2 次完整电压跃迁'}</option></select></span></label>}
        {group==='ratings'&&<p class="group-note">{tx.optional}</p>}
      </fieldset>)}
    </div><div class="form-actions"><button type="submit">{tx.calculate}</button><p class="form-error" data-form-error hidden>{tx.invalid}</p></div>
  </form>

  <div class="tool-results" id="results">
    <section class="tool-result-card tool-result-card--primary" aria-labelledby="design-title"><div class="tool-result-card__heading"><h2 id="design-title">{tx.design}</h2><span class:list={['tool-check-pill',`tool-check-pill--${r.status}`]} data-status>{statusText(r.status)}</span></div>
      <div class="primary-metrics"><div><span>{tx.cs}</span><strong data-output="cs">{fmt.pf(r.cs)}</strong></div><div><span>{tx.rs}</span><strong data-output="rs">{fmt.ohm(r.rs)}</strong></div><div><span>{tx.loss}</span><strong data-output="loss">{r.averageLoss.toFixed(3)} W</strong></div><div><span>{tx.status}</span><strong data-output="status">{statusText(r.status)}</strong></div></div>
      <div class="secondary-results"><div><span>{tx.rawCs}</span><strong data-output="csRaw">{fmt.pf(r.csRaw)}</strong></div><div><span>{tx.rawRs}</span><strong data-output="rsRaw">{fmt.ohm(r.rsRaw)}</strong></div></div><p class="tool-note">{tx.disclaimer}</p>
    </section>
    <section class="tool-result-card"><h2>{tx.parasitics}</h2><div class="metric-grid"><div class="metric-tile"><span>f₀ / f₁</span><strong data-output="ratio">{r.ratio.toFixed(3)}</strong></div><div class="metric-tile"><span>Cp</span><strong data-output="cp">{fmt.pf(r.cp)}</strong></div><div class="metric-tile"><span>Lp</span><strong data-output="lp">{fmt.uh(r.lp)}</strong></div><div class="metric-tile"><span>Z₀</span><strong data-output="z0">{fmt.ohm(r.z0)}</strong></div><div class="metric-tile"><span>{en?'Original period':'原始周期'}</span><strong data-output="t0">{fmt.ns(r.originalPeriod)}</strong></div><div class="metric-tile"><span>{en?'Shifted period':'偏移后周期'}</span><strong data-output="t1">{fmt.ns(r.shiftedPeriod)}</strong></div></div></section>
    <section class="tool-result-card"><h2>{tx.stress}</h2><div class="metric-grid stress-grid"><div class="metric-tile"><span>{en?'Energy per Event':'单次事件能量'}</span><strong data-output="energy">{(r.eventEnergy*1e6).toFixed(3)} µJ</strong></div><div class="metric-tile"><span>{en?'Events per Second':'每秒事件数'}</span><strong data-output="events">{(r.eventsPerSecond/1e3).toFixed(1)} kHz</strong></div><div class="metric-tile"><span>{en?'Average Loss':'平均损耗'}</span><strong data-output="averageLoss">{r.averageLoss.toFixed(3)} W</strong></div><div class="metric-tile"><span>{en?'Initial Peak Current':'初始峰值电流'}</span><strong data-output="ipk">{r.peakCurrent.toFixed(3)} A</strong></div><div class="metric-tile"><span>{en?'Equivalent RMS Current':'等效 RMS 电流'}</span><strong data-output="irms">{(r.rmsCurrent*1e3).toFixed(1)} mA</strong></div><div class="metric-tile"><span>{en?'Initial Peak Power':'初始瞬时功率'}</span><strong data-output="ppk">{r.peakPower.toFixed(1)} W</strong></div><div class="metric-tile"><span>τ</span><strong data-output="tau">{fmt.ns(r.tau)}</strong></div><div class="metric-tile"><span>3τ</span><strong data-output="tau3">{fmt.ns(3*r.tau)}</strong></div><div class="metric-tile"><span>5τ</span><strong data-output="tau5">{fmt.ns(5*r.tau)}</strong></div><div class="metric-tile"><span>{en?'Event Interval':'事件间隔'}</span><strong data-output="interval">{(r.eventInterval*1e6).toFixed(3)} µs</strong></div><div class="metric-tile"><span>5τ / {en?'interval':'间隔'}</span><strong data-output="settling">{(r.settlingRatio*100).toFixed(2)}%</strong></div></div><aside class="note-callout">{en?'Initial peak power is not continuous rated power. Verify the exact resistor pulse-overload curve.':'初始瞬时功率不是连续额定功率，必须核对具体电阻的脉冲过载曲线。'}</aside></section>
    <section class="tool-result-card"><h2>{tx.checks}</h2><div class="engineering-checks" data-checks>{initialChecks.map(({code,status}:any)=>{const copy=checkCopy[locale][code];return <div class:list={['engineering-check',`engineering-check--${status}`]} data-check-code={code}><span>{statusText(status)}</span><div><strong>{copy[0]}</strong><p>{copy[1]}</p></div></div>})}</div></section>
    <section class="tool-result-card"><h2>{tx.bench}</h2><div class="table-wrap"><table><thead><tr><th>{en?'Position':'相对位置'}</th><th>{en?'Calculated':'计算值'}</th><th>E24</th></tr></thead><tbody data-candidates>{r.candidates.map((c:any)=><tr><td>{c.factor} Z₀</td><td>{fmt.ohm(c.raw)}</td><td>{fmt.ohm(c.standard)}</td></tr>)}</tbody></table></div><p class="tool-note">{en?'Lower values provide a stronger current path but can increase loss; higher values limit current but may under-damp. Confirm every candidate at actual voltage, load, temperature and PCB conditions.':'较低阻值提供更强电流通道但可能增加损耗；较高阻值限制电流但可能阻尼不足。必须在实际电压、负载、温度与 PCB 条件下确认。'}</p></section>
  </div>

  <section class="technical-section"><h2>{tx.how}</h2><div class="technical-grid"><article><h3>{en?'What it is and where it connects':'作用与连接位置'}</h3><p>{en?'A series resistor-capacitor branch placed across the actual ringing device or node. Cs bypasses high-frequency current and Rs dissipates energy, lowering Q without removing the parasitics. Typical placements include MOSFET D-S, diodes, switch nodes, transformer rectifiers, half/full bridges and synchronous rectifiers.':'串联电阻电容支路应跨接实际振铃器件或节点。Cs 旁路高频电流，Rs 耗散能量并降低 Q，但不会消除寄生参数。常见位置包括 MOSFET D-S、二极管、开关节点、变压器整流节点、半桥、全桥和同步整流节点。'}</p><aside class="note-callout">{en?'Do not connect across arbitrary nodes: a wrong return can increase common-mode current, loss or stress.':'不得机械跨接任意节点；错误回流路径可能增加共模电流、损耗或应力。'}</aside></article><article><h3>{en?'PCB layout':'PCB 布局'}</h3><ul><li>{en?'Keep the snubber loop extremely short.':'Snubber 回路必须尽可能短。'}</li><li>{en?'Place Rs and Cs beside the target device with a direct return.':'Rs、Cs 靠近目标器件并采用直接回流。'}</li><li>{en?'Avoid long traces or detours through system ground.':'避免长走线或绕行大面积系统地。'}</li><li>{en?'Use a ground spring or coax; long probe grounds create false ringing.':'使用地弹簧或同轴测量；长地线会制造假振铃。'}</li></ul></article></div>
    <article class="procedure"><h3>{en?'Bench procedure':'台架调试步骤'}</h3><ol>{(en?['Measure f₀ without a snubber.','Temporarily parallel a known low-ESL Ctest at the intended location.','Measure f₁ under identical conditions.','Enter the three measurements.','Start with recommended standard Cs and Rs.','Measure first peak, later ringing and temperature.','Try resistance near 0.5Z₀, 0.75Z₀, Z₀ and 1.25Z₀.','Verify minimum, nominal and maximum input.','Verify light, rated and peak load.','Check maximum switching frequency and high temperature.','Verify resistor pulse curves and capacitor high-frequency behavior.','Select final values from bench results.']:['未安装 Snubber 时测量 f₀。','在目标位置临时并联已知低 ESL 的 Ctest。','相同条件下测量 f₁。','输入三项测量。','从建议标准 Cs、Rs 开始。','测量第一峰值、后续振铃与温升。','试验 0.5Z₀、0.75Z₀、Z₀、1.25Z₀ 附近阻值。','验证最低、额定、最高输入。','验证轻载、额定与峰值负载。','检查最高开关频率与高温。','验证电阻脉冲曲线与电容高频特性。','最终值以台架结果为准。']).map(x=><li>{x}</li>)}</ol></article>
    <article><h3>{en?'Measurement cautions':'测量注意事项'}</h3><ul class="compact-list"><li>{en?'Ctest is temporary, not the final snubber capacitor.':'Ctest 是临时测量电容，不是最终 Snubber 电容。'}</li><li>{en?'Use known low-ESL capacitance at nearly the final location.':'使用已知低 ESL 电容，并尽量保持最终安装位置。'}</li><li>{en?'Probe capacitance becomes part of Cp.':'探头电容会成为 Cp 的一部分。'}</li><li>{en?'Keep voltage, load, frequency and probing identical.':'两次测量保持电压、负载、频率和探测方式一致。'}</li><li>{en?'Small shifts amplify error; nonlinear capacitance makes results operating-point specific.':'频移太小会放大误差；非线性电容使结果只代表该工作点。'}</li></ul></article>
  </section>

  <section class="technical-section math-section"><h2>{tx.math}</h2><article><h3>{en?'Physical origin and natural frequency':'物理来源与自然频率'}</h3><p>{en?'PCB and package inductance, transformer leakage, MOSFET output capacitance, diode and winding capacitance, plus probe and pad parasitics form an equivalent LC network. Fast switching exchanges magnetic and electric energy; loss makes the oscillation decay.':'PCB 与封装电感、变压器漏感、MOSFET 输出电容、二极管与绕组电容，以及探头和焊盘寄生共同形成等效 LC 网络。快速开关使磁场与电场能量交换，实际损耗使振荡衰减。'}</p><div class="equation-block"><math display="block" aria-label="inductor and capacitor stored energy"><mtable><mtr><mtd><msub><mi>W</mi><mi>L</mi></msub><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>L</mi><msup><mi>i</mi><mn>2</mn></msup></mtd></mtr><mtr><mtd><msub><mi>W</mi><mi>C</mi></msub><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>C</mi><msup><mi>v</mi><mn>2</mn></msup></mtd></mtr></mtable></math></div><div class="equation-block"><math display="block" aria-label="natural angular frequency and ringing frequency"><mtable><mtr><mtd><msub><mi>ω</mi><mn>0</mn></msub><mo>=</mo><mfrac><mn>1</mn><msqrt><mrow><msub><mi>L</mi><mi>p</mi></msub><mo>⁢</mo><msub><mi>C</mi><mi>p</mi></msub></mrow></msqrt></mfrac></mtd></mtr><mtr><mtd><msub><mi>f</mi><mn>0</mn></msub><mo>=</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mi>π</mi><msqrt><mrow><msub><mi>L</mi><mi>p</mi></msub><mo>⁢</mo><msub><mi>C</mi><mi>p</mi></msub></mrow></msqrt></mrow></mfrac></mtd></mtr></mtable></math></div></article>
    <article><h3>{en?'Frequency-shift extraction':'频移参数提取'}</h3><div class="equation-block"><math display="block" aria-label="frequency shift derivation for parasitic capacitance and inductance"><mtable><mtr><mtd><msub><mi>f</mi><mn>0</mn></msub><mo>=</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mi>π</mi><msqrt><mrow><msub><mi>L</mi><mi>p</mi></msub><msub><mi>C</mi><mi>p</mi></msub></mrow></msqrt></mrow></mfrac></mtd></mtr><mtr><mtd><msub><mi>f</mi><mn>1</mn></msub><mo>=</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mi>π</mi><msqrt><mrow><msub><mi>L</mi><mi>p</mi></msub><mo>(</mo><msub><mi>C</mi><mi>p</mi></msub><mo>+</mo><msub><mi>C</mi><mtext>test</mtext></msub><mo>)</mo></mrow></msqrt></mrow></mfrac></mtd></mtr><mtr><mtd><msup><mrow><mo>(</mo><mfrac><msub><mi>f</mi><mn>0</mn></msub><msub><mi>f</mi><mn>1</mn></msub></mfrac><mo>)</mo></mrow><mn>2</mn></msup><mo>=</mo><mfrac><mrow><msub><mi>C</mi><mi>p</mi></msub><mo>+</mo><msub><mi>C</mi><mtext>test</mtext></msub></mrow><msub><mi>C</mi><mi>p</mi></msub></mfrac></mtd></mtr><mtr><mtd><msub><mi>C</mi><mi>p</mi></msub><mo>=</mo><mfrac><msub><mi>C</mi><mtext>test</mtext></msub><mrow><msup><mrow><mo>(</mo><mfrac><msub><mi>f</mi><mn>0</mn></msub><msub><mi>f</mi><mn>1</mn></msub></mfrac><mo>)</mo></mrow><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow></mfrac></mtd></mtr><mtr><mtd><msub><mi>L</mi><mi>p</mi></msub><mo>=</mo><mfrac><mn>1</mn><mrow><msup><mrow><mo>(</mo><mn>2</mn><mi>π</mi><msub><mi>f</mi><mn>0</mn></msub><mo>)</mo></mrow><mn>2</mn></msup><msub><mi>C</mi><mi>p</mi></msub></mrow></mfrac></mtd></mtr></mtable></math></div></article>
    <div class="technical-grid"><article><h3>{en?'Characteristic impedance':'特征阻抗'}</h3><div class="equation-block"><math display="block" aria-label="characteristic impedance"><msub><mi>Z</mi><mn>0</mn></msub><mo>=</mo><msqrt><mfrac><msub><mi>L</mi><mi>p</mi></msub><msub><mi>C</mi><mi>p</mi></msub></mfrac></msqrt></math></div><p>{en?'Z₀ is a common first-pass resistance scale, not a uniquely optimal value. Placement, nonlinear capacitance, edge rate and layout still matter.':'Z₀ 是常用的一阶电阻尺度，并非唯一最优值；连接位置、非线性电容、边沿和布局仍会影响结果。'}</p></article><article><h3>{en?'Energy and average loss':'能量与平均损耗'}</h3><div class="equation-block"><math display="block" aria-label="event energy and average snubber power"><mtable><mtr><mtd><msub><mi>E</mi><mtext>event</mtext></msub><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><msub><mi>C</mi><mi>s</mi></msub><msup><mrow><mo>(</mo><mi>ΔV</mi><mo>)</mo></mrow><mn>2</mn></msup></mtd></mtr><mtr><mtd><msub><mi>P</mi><mtext>snub</mtext></msub><mo>=</mo><msub><mi>N</mi><mi>e</mi></msub><mo>·</mo><msub><mi>E</mi><mtext>event</mtext></msub><mo>·</mo><msub><mi>f</mi><mtext>sw</mtext></msub></mtd></mtr></mtable></math></div><p>{en?'The formula screens components; waveform shape, residual voltage and incomplete charging can change real loss.':'该公式用于器件初筛；波形、残余电压和不完整充放电会改变实际损耗。'}</p></article></div>
    <article><h3>{en?'Model limitations':'模型限制'}</h3><ul class="compact-list"><li>{en?'One dominant lumped LC mode and approximately fixed Lp.':'假设单一主导集中参数 LC 模态且 Lp 近似不变。'}</li><li>{en?'Ctest is approximately parallel with Cp.':'Ctest 与 Cp 近似并联。'}</li><li>{en?'Nonlinear Coss, junction capacitance, reverse recovery and magnetic nonlinearities are omitted.':'忽略非线性 Coss、结电容、反向恢复和磁性非线性。'}</li><li>{en?'Nearby modes and distributed effects are omitted; results apply near the measured operating point.':'忽略相近模态与分布参数；结果只适用于测量工作点附近。'}</li></ul></article>
  </section>

  <section class="technical-section references"><h2>{tx.refs}</h2><ul><li><a href="https://www.ti.com/lit/pdf/ssztbc7" target="_blank" rel="noopener noreferrer">{en?'Power Tips: Calculate an R-C Snubber in Seven Steps':'Power Tips：七步计算 R-C Snubber'}</a> — Texas Instruments. {en?'Frequency-shift extraction, Cs ≈ 3Cp, Rs near Z₀ and bench tuning.':'支持频移提取、Cs ≈ 3Cp、Rs 取 Z₀ 附近与台架调优。'}</li><li><a href="https://www.ti.com/lit/pdf/slva255" target="_blank" rel="noopener noreferrer">Minimizing Ringing at the Switch Node of a Boost Converter</a> — Texas Instruments. {en?'C·V²·fsw loss, tradeoffs and boost-converter layout example.':'支持 C·V²·fsw 损耗、折中与 Boost 布局示例。'}</li><li><a href="https://www.ti.com/lit/pdf/slpa010" target="_blank" rel="noopener noreferrer">Ringing Reduction Techniques for NexFET High Performance MOSFETs</a> — Texas Instruments. {en?'Resistance variation, measurement and PCB guidance in a synchronous-buck context.':'支持同步 Buck 背景下的阻值变化、测量与 PCB 指导。'}</li></ul><aside class="note-callout">{en?'This calculator converts published first-pass methods into an interactive estimate. It does not replace bench measurement or manufacturer pulse-rating verification. Series RC only—not RCD clamps, TVS, active clamps, exact nonlinear models, waveform fitting or final EMI compliance.':'本工具将公开的一阶方法转化为交互估算，不能替代台架测量或厂商脉冲额定值验证。仅处理串联 RC，不处理 RCD 钳位、TVS、有源钳位、精确非线性模型、波形拟合或最终 EMI 合规。'}</aside></section>
</main>
</BaseLayout>

<script is:inline define:vars={{ locale, checkCopy, tx }}>
  const root=document.querySelector('[data-rc-snubber]');const form=root?.querySelector('[data-snubber-form]');const localizedStatus=locale==='zh'?{pass:'通过',review:'复核',fail:'不通过'}:{pass:'Pass',review:'Review',fail:'Fail'};
  const resultKeys=['cs','rs','loss','status','csRaw','rsRaw','ratio','cp','lp','z0','t0','t1','energy','events','averageLoss','ipk','irms','ppk','tau','tau3','tau5','interval','settling'];
  const output=(key,value)=>{const el=root?.querySelector(`[data-output="${key}"]`);if(el)el.textContent=value};const raw=(key)=>form?.querySelector(`[data-input="${key}"]`)?.value??'';const number=(key)=>raw(key).trim()===''?NaN:Number(raw(key));const optional=(key)=>raw(key).trim()===''?undefined:Number(raw(key));
  const clear=()=>{resultKeys.forEach(key=>output(key,'—'));const body=root?.querySelector('[data-candidates]');if(body)body.innerHTML=''};
  const setStatus=(status)=>{const label=localizedStatus[status];const badge=root?.querySelector('[data-status]');if(badge){badge.textContent=label;badge.className=`tool-check-pill tool-check-pill--${status}`}output('status',label)};
  const renderChecks=(result)=>{const box=root?.querySelector('[data-checks]');if(!box)return;const items=[...result.errors.map(code=>({code,status:'fail'})),...result.warnings.map(code=>({code,status:['pulse-rating','measurement-parasitics'].includes(code)?'pass':'review'}))];box.innerHTML=items.map(({code,status})=>{const copy=checkCopy[locale][code]||[code,code];return `<div class="engineering-check engineering-check--${status}" data-check-code="${code}"><span>${localizedStatus[status]}</span><div><strong>${copy[0]}</strong><p>${copy[1]}</p></div></div>`}).join('')};
  const update=(force=false)=>{const inputs={f0MHz:number('f0MHz'),cTestPf:number('cTestPf'),f1MHz:number('f1MHz'),deltaVV:number('deltaVV'),switchingFrequencyKhz:number('switchingFrequencyKhz'),eventsPerCycle:number('eventsPerCycle'),capacitorMultiplier:number('capacitorMultiplier'),resistorMultiplier:number('resistorMultiplier'),resistorRatedPowerW:optional('resistorRatedPowerW'),capacitorVoltageRatingV:optional('capacitorVoltageRatingV'),powerDeratingLimit:number('powerDeratingLimit')/100,voltageDeratingLimit:number('voltageDeratingLimit')/100};const result=window.calculateSnubber(inputs);const error=form?.querySelector('[data-form-error]');
    if(result.status==='fail'&&!result.ratio){clear();setStatus('fail');renderChecks(result);if(error){error.hidden=!force;error.textContent=tx.invalid}return}if(error)error.hidden=true;const pf=v=>`${(v*1e12).toFixed(1)} pF`,ohm=v=>`${v.toFixed(1)} Ω`,ns=v=>`${(v*1e9).toFixed(1)} ns`;
    output('cs',pf(result.cs));output('rs',ohm(result.rs));output('loss',`${result.averageLoss.toFixed(3)} W`);output('csRaw',pf(result.csRaw));output('rsRaw',ohm(result.rsRaw));output('ratio',result.ratio.toFixed(3));output('cp',pf(result.cp));output('lp',`${(result.lp*1e6).toFixed(3)} µH`);output('z0',ohm(result.z0));output('t0',ns(result.originalPeriod));output('t1',ns(result.shiftedPeriod));output('energy',`${(result.eventEnergy*1e6).toFixed(3)} µJ`);output('events',`${(result.eventsPerSecond/1e3).toFixed(1)} kHz`);output('averageLoss',`${result.averageLoss.toFixed(3)} W`);output('ipk',`${result.peakCurrent.toFixed(3)} A`);output('irms',`${(result.rmsCurrent*1e3).toFixed(1)} mA`);output('ppk',`${result.peakPower.toFixed(1)} W`);output('tau',ns(result.tau));output('tau3',ns(3*result.tau));output('tau5',ns(5*result.tau));output('interval',`${(result.eventInterval*1e6).toFixed(3)} µs`);output('settling',`${(result.settlingRatio*100).toFixed(2)}%`);setStatus(result.status);renderChecks(result);const body=root?.querySelector('[data-candidates]');if(body)body.innerHTML=result.candidates.map(c=>`<tr><td>${c.factor} Z₀</td><td>${ohm(c.raw)}</td><td>${ohm(c.standard)}</td></tr>`).join('')};
  form?.addEventListener('submit',event=>{event.preventDefault();update(true)});form?.addEventListener('input',()=>update(false));form?.addEventListener('change',()=>update(false));
</script>
<script>
  import { calculateRCSnubber } from '@/lib/rcSnubberFirstPass';
  Object.assign(window,{calculateSnubber:calculateRCSnubber});
</script>

